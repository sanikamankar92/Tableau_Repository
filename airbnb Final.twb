      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0790321825349633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Review Scores Rating]*[Number Of Reviews]' />
      </column>
      <column caption='Total Price' datatype='integer' name='[Calculation_0790321826082819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Price])' />
      </column>
      <column caption='Pricing Category' datatype='string' name='[Calculation_0790321827753988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;LUXURY&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;STANDARD&quot;&#13;&#10;ELSE &quot;BUDGET&quot;&#13;&#10;END' />
      </column>
      <column caption='Review category' datatype='string' name='[Calculation_0790321830637573]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;HIGHLY REVIEWED&quot;&#13;&#10;ELSE &quot;LESS REVIEWED&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0790321831854086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY()THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Review Score Rating' datatype='real' name='[Calculation_0790321833275399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Review Scores Rating])' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0790321837195274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0790321835552776]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column caption='Neighbourhood' datatype='string' name='[Neighbourhood ]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Price]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
